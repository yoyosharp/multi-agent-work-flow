# api-config.env — project API scaffold for the api.sh manual-test driver.
# TEMPLATE ONLY — the control plane copies this to .history/_bin/api-config.env
# at init; fill every <...> only if the project uses api.sh (the manual-test
# driver) — otherwise leave the template. It keeps adapting that live copy
# during work (auth-flow/base/envelope changes land here first, never in
# api.sh). The live file is machine-local and gitignored with .history/.
#
# Body templates may use %U = username, %P = password, %O = OTP/second factor.


# --- Fill these for YOUR project (the plane replaces every <...>) ---
MT_BASE_DEFAULT="<http://localhost:PORT/api/v1>"
MT_USER_DEFAULT="<default-account-username>"
MT_PASS_DEFAULT="<default-account-password>"
MT_OTP_DEFAULT="<default-account-otp-or-blank>"
MT_SESSION_HEADER="<session-header-name-e.g.-X-Session-Id>"
MT_BODY_ENVELOPE="<request-envelope-key-or-blank-for-none>"
MT_AUTH_LOGIN_URL="<login-endpoint-path>"
MT_AUTH_LOGIN_BODY='<json-with-%U-%P>'
MT_AUTH_LOGIN_JQ="<jq-expr-for-session-token-from-login-response-or-blank>"
MT_AUTH_VERIFY_URL="<second-step-endpoint-path-or-blank-for-single-step>"
MT_AUTH_VERIFY_BODY='<json-with-%U-%O>'
MT_AUTH_VERIFY_JQ="<jq-expr-for-session-token-from-verify-response>"
MT_AUTH_GAP="<seconds-between-steps-default-2>"
# --- App server lifecycle (v6 track F: server.sh start/stop) ---
# MT_BOOT_CMD: single simple command, no pipes/redirects/&&/; (it runs via
# `bash -c "exec ..."`, so a compound command would not exec cleanly).
# MT_SERVER_MATCH: substring that must appear in the LIVE server process
# cmdline — plane-only, NEVER a per-task override: mt-config.env is
# worker-writable and must not choose what counts as the server.
# The port is parsed from MT_BASE(_DEFAULT) above (the manual-test token's
# port). server.sh start refuses without all three (fail closed).
MT_BOOT_CMD="<app-boot-command-e.g.-mvn-pl-<module>-spring-boot:run>"
MT_SERVER_MATCH="<substring-in-server-cmdline-e.g.-spring-boot:run-or-app.jar>"
